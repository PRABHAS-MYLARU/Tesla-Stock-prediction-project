# Import Libraries
import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error
from sklearn.ensemble import RandomForestRegressor
from xgboost import XGBRegressor
from tensorflow.keras.models import SequentialFFG
from tensorflow.keras.layers import LSTM, Dense, Dropout
import datetime
import warnings
warnings.filterwarnings('ignore')

# Download Tesla Stock Data
ticker = 'TSLA'
start_date = '2015-01-01'
end_date = datetime.date.today().strftime('%Y-%m-%d')

data = yf.download(ticker, start=start_date, end=end_date)
data = data[['Close']]
data.dropna(inplace=True)
print(data.tail())

#  Plot Closing Price
plt.figure(figsize=(10, 4))
plt.plot(data, label='Tesla Closing Price')
plt.title('Tesla Stock Price')
plt.xlabel('Date')
plt.ylabel('Close Price USD ($)')
plt.legend()
plt.show()

#  Scaling Data for LSTM
scaler = MinMaxScaler()
scaled_data = scaler.fit_transform(data)

# 🔁 Create Sequences for LSTM (60-day window)
def create_sequences(data, time_steps=60):
    X, y = [], []
    for i in range(time_steps, len(data)):
        X.append(data[i - time_steps:i])
        y.append(data[i])
    return np.array(X), np.array(y)
X, y = create_sequences(scaled_data)
#  Split Train/Test
train_size = int(len(X) * 0.8)
X_train, y_train = X[:train_size], y[:train_size]
X_test, y_test = X[train_size:], y[train_size:]

# Build LSTM Model
model = Sequential([
    LSTM(50, return_sequences=True, input_shape=(X_train.shape[1], 1)),
    Dropout(0.2),
    LSTM(50, return_sequences=False),
    Dropout(0.2),
    Dense(25),
    Dense(1)
])

model.compile(optimizer='adam', loss='mean_squared_error')
model.fit(X_train, y_train, batch_size=32, epochs=10, verbose=1)

# Predict with LSTM
predicted = model.predict(X_test)
predicted = scaler.inverse_transform(predicted)
actual = scaler.inverse_transform(y_test)

#  Calculate RMSE
rmse = np.sqrt(mean_squared_error(actual, predicted))
print(f"LSTM RMSE: {rmse:.2f}")

#  Plot Results
plt.figure(figsize=(10, 4))
plt.plot(actual, label='Actual')
plt.plot(predicted, label='Predicted')
plt.title('Tesla Stock Price Prediction (LSTM)')
plt.xlabel('Days')
plt.ylabel('Close Price USD ($)')
plt.legend()
plt.show()

#  Add features
df = data.copy()
df['MA7'] = df['Close'].rolling(window=7).mean()
df['MA21'] = df['Close'].rolling(window=21).mean()
df['STD'] = df['Close'].rolling(window=7).std()
df.dropna(inplace=True)

# Target and Features
features = ['MA7', 'MA21', 'STD']
target = 'Close'
X_ml = df[features]
y_ml = df[target]

# Split
split_idx = int(len(df) * 0.8)
X_train_ml, X_test_ml = X_ml[:split_idx], X_ml[split_idx:]
y_train_ml, y_test_ml = y_ml[:split_idx], y_ml[split_idx:]

#  Random Forest
rf = RandomForestRegressor(n_estimators=100)
rf.fit(X_train_ml, y_train_ml)
rf_pred = rf.predict(X_test_ml)
rf_rmse = np.sqrt(mean_squared_error(y_test_ml, rf_pred))
print(f"Random Forest RMSE: {rf_rmse:.2f}")


#  XGBoost
xgb = XGBRegressor(n_estimators=100, learning_rate=0.1)
xgb.fit(X_train_ml, y_train_ml)
xgb_pred = xgb.predict(X_test_ml)
xgb_rmse = np.sqrt(mean_squared_error(y_test_ml, xgb_pred))
print(f"XGBoost RMSE: {xgb_rmse:.2f}")

#  Compare All
plt.figure(figsize=(10, 5))
plt.plot(y_test_ml.values, label='Actual')
plt.plot(rf_pred, label='RF Predicted')
plt.plot(xgb_pred, label='XGBoost Predicted')
plt.title('Tesla Price Prediction (ML Models)')
plt.legend()
plt.show()
